# Copia este archivo a `.env` y rellena los valores. `.env` esta en .gitignore.
#
# Credenciales de Spotify: crea una app en https://developer.spotify.com/dashboard
# y anade esta Redirect URI EXACTA (debe coincidir con config.yaml):
#
#     http://127.0.0.1:8888/callback
#
# Se usa el flujo PKCE, pensado para aplicaciones de escritorio: no hay servidor
# donde esconder un secreto, asi que CLIENT_SECRET no es necesario y se deja
# vacio. Solo hace falta el CLIENT_ID.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
